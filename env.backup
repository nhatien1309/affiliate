# Copy file này thành .env rồi điền. KHÔNG gửi file .env cho ai, không đưa lên GitHub.

# ---- Giọng đọc ----
# edge (miễn phí, để thử) | elevenlabs | fpt | silent (không tiếng, chỉ thử bố cục)
TTS_PROVIDER=edge
EDGE_VOICE=vi-VN-HoaiMyNeural
# EDGE_VOICE=vi-VN-NamMinhNeural
EDGE_RATE=+8%

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model hỗ trợ tiếng Việt. Nếu ElevenLabs báo lỗi model, xem danh sách model trên trang ElevenLabs.
ELEVENLABS_MODEL=eleven_flash_v2_5

FPT_API_KEY=
# banmai, thuminh, myan, giahuy, ngoclam, leminh, minhquang, linhsan, lannhi
FPT_VOICE=banmai
FPT_SPEED=0

# ---- Shopee Affiliate Open API (không bắt buộc) ----
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---- Vận hành ----
# duyet_tung_video | duyet_theo_lo | tu_dang_facebook
APPROVAL_MODE=duyet_tung_video
MAX_PER_DAY=2
# Đổi thành true khi tài khoản TikTok đủ điều kiện gắn giỏ hàng (mốc 1.000 follower)
TIKTOK_HAS_CART=false
