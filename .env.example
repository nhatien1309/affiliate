# Copy file này thành .env rồi điền. KHÔNG gửi file .env cho ai, không đưa lên GitHub.

# ---- Giọng đọc ----
# Dễ nhất: chọn giọng trên giao diện (python -m agent ui → Giọng đọc). Lựa chọn đó lưu ở brand/brand.json
# và được ưu tiên hơn các dòng TTS_PROVIDER, EDGE_*, ELEVENLABS_VOICE_ID, FPT_VOICE dưới đây.
# edge (miễn phí, để thử) | elevenlabs | fpt | silent (không tiếng, chỉ thử bố cục)
TTS_PROVIDER=edge
EDGE_VOICE=vi-VN-HoaiMyNeural
# EDGE_VOICE=vi-VN-NamMinhNeural
EDGE_RATE=+8%
# Cao độ: âm = trầm hơn, dương = cao hơn
EDGE_PITCH=+0Hz

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model hỗ trợ tiếng Việt. Nếu ElevenLabs báo lỗi model, xem danh sách model trên trang ElevenLabs.
ELEVENLABS_MODEL=eleven_flash_v2_5

FPT_API_KEY=
# banmai, thuminh, myan, giahuy, ngoclam, leminh, minhquang, linhsan, lannhi
FPT_VOICE=banmai
FPT_SPEED=0

# ---- Dựng hình ----
# ffmpeg (mặc định, chỉ cần ffmpeg) | hyperframes (motion graphics, cần Node.js)
VIDEO_ENGINE=ffmpeg
# draft (nhanh, để xem thử) | standard | high
HYPERFRAMES_QUALITY=standard
HYPERFRAMES_VERSION=0.8.82

# ---- Shopee Affiliate Open API (không bắt buộc) ----
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---- Vận hành ----
# duyet_tung_video | duyet_theo_lo | tu_dang_facebook
APPROVAL_MODE=duyet_tung_video
MAX_PER_DAY=2
# Đổi thành true khi tài khoản TikTok đủ điều kiện gắn giỏ hàng (mốc 1.000 follower)
TIKTOK_HAS_CART=false
