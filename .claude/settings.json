{
  "permissions": {
    "allow": [
      "Bash(python -m agent:*)",
      "Bash(python3 -m agent:*)",
      "Bash(python -c:*)",
      "Bash(ffprobe:*)",
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "mcp__metricool",
      "mcp__vidiq"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./env.backup)",
      "Edit(./env.backup)",
      "Write(./env.backup)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/kich_hoat_venv.sh\""
          }
        ]
      }
    ]
  }
}
